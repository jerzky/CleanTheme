<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CleanTheme.Wpf.Controls"
                    xmlns:theme="clr-namespace:CleanTheme.Wpf">

    <!-- Default styles of the CleanTheme controls. The palette is merged here so the controls look right
         even in an application that has not merged CleanThemeResources. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CleanTheme.Wpf;component/Themes/CleanTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="controls:StatusPill">
        <Setter Property="Background" Value="{DynamicResource NeutralSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusPill">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{TemplateBinding Foreground}" Margin="0,0,5,0"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                            <Path x:Name="IconPath" Data="{TemplateBinding Icon}" Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                            <Button x:Name="PART_CloseButton" Style="{x:Null}" Focusable="False" Margin="5,0,-2,0"
                                    VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Width="12" Height="12" SnapsToDevicePixels="True">
                                            <Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.65" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasIcon" Value="True">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="State" Value="Info">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="State" Value="Positive">
                <Setter Property="Background" Value="{DynamicResource PositiveSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Positive}" />
            </Trigger>
            <Trigger Property="State" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            </Trigger>
            <Trigger Property="State" Value="Negative">
                <Setter Property="Background" Value="{DynamicResource NegativeSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Negative}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="controls:Card">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Card">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <DockPanel x:Name="TitleRow" DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                                <ContentPresenter DockPanel.Dock="Left" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource Text}" />
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Actions" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TitleRow" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:MetricTile">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MetricTile">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{TemplateBinding Label}" />
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{TemplateBinding Value}" VerticalAlignment="Bottom"
                                              TextElement.FontSize="18" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{DynamicResource Text}"
                                              Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="UnitText" Text="{TemplateBinding Unit}" Margin="4,0,0,3" VerticalAlignment="Bottom"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control: a sunken track holding the choices; the selected one is lifted onto the surface. -->
    <Style TargetType="controls:SegmentedControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="2"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SegmentedItem">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedItem">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A text box with no chrome, for use inside composite controls. -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small borderless icon button (clear, close, spin). -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SearchBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SearchBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M 4.5,0.5 A 4,4 0 1 1 4.49,0.5 Z M 7.5,7.5 L 11,11" Stroke="{DynamicResource TextSubtle}" StrokeThickness="1.4"
                                  Margin="9,0,6,0" VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" Margin="2,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSubtle}" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="PART_ClearButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="20" Height="20"
                                    Margin="0,0,4,0" ToolTip="Clear (Esc)">
                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleSwitch">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="{DynamicResource BorderStrong}"
                                BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource OnAccent}" HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:EmptyState">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EmptyState">
                    <StackPanel Margin="{TemplateBinding Padding}" MaxWidth="360">
                        <Path x:Name="IconPath" Data="{TemplateBinding Icon}" Stroke="{DynamicResource TextSubtle}" StrokeThickness="1.5"
                              Stretch="Uniform" Width="32" Height="32" Margin="0,0,0,10" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <ContentPresenter x:Name="Action" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:NumericUpDown">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NumericUpDown">
                    <Border x:Name="Chrome" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PART_TextBox" Style="{StaticResource BareTextBox}" Padding="6,0,4,0" TextAlignment="Right"
                                     Typography.NumeralAlignment="Tabular" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <RepeatButton x:Name="PART_IncreaseButton" Style="{StaticResource IconButton}" Margin="0,2,2,0" ToolTip="Increase">
                                    <Path Data="M 0,4 L 3.5,0 L 7,4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                          StrokeThickness="1.3" />
                                </RepeatButton>
                                <RepeatButton x:Name="PART_DecreaseButton" Grid.Row="1" Style="{StaticResource IconButton}" Margin="0,0,2,2"
                                              ToolTip="Decrease">
                                    <Path Data="M 0,0 L 3.5,4 L 7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                          StrokeThickness="1.3" />
                                </RepeatButton>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toasts: white cards with a colored stripe, stacked bottom-right. The host passes clicks through elsewhere. -->
    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type controls:ToastMessage}">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6"
                Margin="0,8,0,0" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.14" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Stripe" CornerRadius="5,0,0,5" Background="{DynamicResource Accent}" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="12,10,8,10"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="0,6,6,0" VerticalAlignment="Top"
                        Command="{x:Static controls:ToastHost.DismissCommand}" CommandParameter="{Binding}" ToolTip="Close">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" />
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Neutral">
                <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource BorderStrong}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Positive">
                <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Warning">
                <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Negative">
                <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Negative}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="controls:ToastHost">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToastHost">
                    <ItemsControl x:Name="Stack" ItemsSource="{Binding Toasts, RelativeSource={RelativeSource TemplatedParent}}"
                                  ItemTemplate="{StaticResource ToastTemplate}" Focusable="False"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="340" Margin="16" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialogs: body on the surface, buttons right-aligned in a sunken footer. -->
    <Style TargetType="controls:CleanDialog">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="theme:WindowTheme.FollowTheme" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CleanDialog">
                    <Border Background="{TemplateBinding Background}">
                        <AdornerDecorator>
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Divider}"
                                        BorderThickness="0,1,0,0" Padding="16,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="PART_SecondaryButton" Content="{TemplateBinding SecondaryButtonText}" IsCancel="True"
                                                MinWidth="84" Margin="0,0,8,0" />
                                        <Button x:Name="PART_PrimaryButton" Content="{TemplateBinding PrimaryButtonText}" IsDefault="True"
                                                MinWidth="84" Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="20,18,20,20">
                                    <TextBlock x:Name="HeadingText" Text="{TemplateBinding Heading}" FontSize="15" FontWeight="SemiBold"
                                               Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <ContentPresenter />
                                </StackPanel>
                            </DockPanel>
                        </AdornerDecorator>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SecondaryButtonText" Value="{x:Null}">
                            <Setter TargetName="PART_SecondaryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Heading" Value="{x:Null}">
                            <Setter TargetName="HeadingText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDanger" Value="True">
                            <Setter TargetName="PART_PrimaryButton" Property="Style" Value="{StaticResource DangerPrimaryButton}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hamburger menu and navigation items -->
    <Style TargetType="controls:HamburgerMenuItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HamburgerMenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Margin="4,1" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Selection indicator bar on the left edge -->
                            <Border x:Name="SelectionBar" Width="3" CornerRadius="1.5"
                                    Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Margin="2,5" Visibility="Collapsed" />

                            <Grid x:Name="InnerGrid" Margin="6,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="IconColumn" Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Grid x:Name="IconContainer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20">
                                    <Path x:Name="IconPath" Data="{TemplateBinding Icon}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="IconPresenter" Content="{TemplateBinding IconElement}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Text label / Content -->
                                <Grid Grid.Column="1" x:Name="TextContainer" VerticalAlignment="Center" Margin="6,0,4,0">
                                    <TextBlock x:Name="TextLabel" Text="{TemplateBinding Text}" TextTrimming="CharacterEllipsis"
                                               Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      VerticalAlignment="Center" />
                                </Grid>

                                <!-- Badge (pill) -->
                                <Border Grid.Column="2" x:Name="BadgeContainer"
                                        Background="{DynamicResource NeutralSoft}"
                                        CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IconElement" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="TextLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgeContainer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsPaneOpen" Value="False">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="TextContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BadgeContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerGrid" Property="Margin" Value="0" />
                            <Setter TargetName="Chrome" Property="Margin" Value="0,1" />
                            <Setter TargetName="IconContainer" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="IconContainer" Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=controls:HamburgerMenu}}" Value="False">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="TextContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BadgeContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerGrid" Property="Margin" Value="0" />
                            <Setter TargetName="Chrome" Property="Margin" Value="0,1" />
                            <Setter TargetName="IconContainer" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="IconContainer" Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact footer profile button with drop-up menu -->
    <Style TargetType="controls:HamburgerProfileButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AvatarBackground" Value="{DynamicResource AccentSoft}" />
        <Setter Property="AvatarForeground" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HamburgerProfileButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="6,4" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Circular Avatar Badge (22x22) -->
                            <Border x:Name="AvatarBadge" Width="22" Height="22" CornerRadius="11"
                                    Background="{TemplateBinding AvatarBackground}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Avatar, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding AvatarForeground}"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Display Name + Subtitle + Chevron -->
                            <StackPanel x:Name="NamePanel" Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock Text="{TemplateBinding DisplayName}" FontWeight="Medium"
                                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}"
                                           Foreground="{DynamicResource TextSubtle}" Margin="4,0,5,0" />
                                <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{DynamicResource TextSubtle}"
                                      StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>

                            <!-- Trailing action button (e.g. bug report / feedback) -->
                            <Button x:Name="PART_TrailingButton" Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Width="24" Height="24" Padding="4"
                                    Command="{TemplateBinding TrailingCommand}"
                                    ToolTip="{TemplateBinding TrailingToolTip}"
                                    Focusable="False"
                                    VerticalAlignment="Center">
                                <Path Data="{TemplateBinding TrailingIcon}"
                                      Stroke="{DynamicResource TextSubtle}" StrokeThickness="1.3"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="TrailingIcon" Value="{x:Null}">
                            <Setter TargetName="PART_TrailingButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=controls:HamburgerMenu}}" Value="False">
                            <Setter TargetName="NamePanel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TrailingButton" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hamburger menu shell -->
    <Style TargetType="controls:HamburgerMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="PaneBackground" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HamburgerMenu">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Navigation Pane -->
                        <Border x:Name="PART_Pane"
                                Grid.Column="0"
                                Background="{TemplateBinding PaneBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Width="{TemplateBinding CompactPaneWidth}"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <DockPanel LastChildFill="True">
                                <!-- Header area (Logo + Hamburger button) -->
                                <StackPanel DockPanel.Dock="Top" x:Name="HeaderPanel">
                                    <!-- When pane is open: Header row with Logo and Hamburger button -->
                                    <Grid x:Name="OpenHeaderRow" Margin="10,12,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="PART_HeaderPresenter"
                                                          Grid.Column="0"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          VerticalAlignment="Center" />
                                        <Button x:Name="PART_HamburgerButton"
                                                Grid.Column="1"
                                                Style="{StaticResource GhostButton}"
                                                Width="32" Height="32" Padding="6"
                                                ToolTip="{TemplateBinding HamburgerToolTip}"
                                                Focusable="False"
                                                VerticalAlignment="Center">
                                            <Path Data="M 3,6 H 21 M 3,12 H 21 M 3,18 H 21"
                                                  Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="15" Height="13" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <!-- When pane is closed: Compact header icon (if any) and centered hamburger button -->
                                    <StackPanel x:Name="CompactHeaderRow" Margin="0,10,0,8" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <ContentPresenter x:Name="PART_CompactHeaderPresenter"
                                                          Content="{TemplateBinding CompactHeader}"
                                                          ContentTemplate="{TemplateBinding CompactHeaderTemplate}"
                                                          HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <Button x:Name="PART_CompactHamburgerButton"
                                                Style="{StaticResource GhostButton}"
                                                Width="32" Height="32" Padding="6"
                                                ToolTip="{TemplateBinding HamburgerToolTip}"
                                                Focusable="False"
                                                HorizontalAlignment="Center">
                                            <Path Data="M 3,6 H 21 M 3,12 H 21 M 3,18 H 21"
                                                  Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="15" Height="13" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Footer area (Profile button / settings / dropup menu) -->
                                <Border x:Name="FooterBorder" DockPanel.Dock="Bottom"
                                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                                        Padding="6,8" SnapsToDevicePixels="True">
                                    <ContentPresenter Content="{TemplateBinding Footer}"
                                                      ContentTemplate="{TemplateBinding FooterTemplate}" />
                                </Border>

                                <!-- Navigation items -->
                                <ScrollViewer Focusable="False"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              Padding="4,4">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Content area -->
                        <ContentPresenter Grid.Column="1"
                                          x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- When IsPaneOpen is true -->
                        <Trigger Property="IsPaneOpen" Value="True">

                            <Setter TargetName="OpenHeaderRow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CompactHeaderRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- When IsPaneOpen is false -->
                        <Trigger Property="IsPaneOpen" Value="False">

                            <Setter TargetName="OpenHeaderRow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CompactHeaderRow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Hamburger button visibility -->
                        <Trigger Property="IsHamburgerVisible" Value="False">
                            <Setter TargetName="PART_HamburgerButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CompactHamburgerButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CompactHeader" Value="{x:Null}">
                            <Setter TargetName="PART_CompactHeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Searchable Settings Controls -->

    <!-- Two-column setting row: label on left, control on right -->
    <Style TargetType="controls:SettingRow">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0,14" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{TemplateBinding HeaderWidth}" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Header + Asterisk + Description -->
                            <StackPanel Grid.Column="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.FontWeight="Medium"
                                                      TextElement.FontSize="13"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="RequiredIndicator" Text=" *" Foreground="{DynamicResource Accent}"
                                               FontWeight="Bold" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}"
                                           FontSize="12" Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Right Column: Interactive Editor Control -->
                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRequired" Value="True">
                            <Setter TargetName="RequiredIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMatch" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings section grouping SettingRows -->
    <Style TargetType="controls:SettingsGroup">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsGroup">
                    <StackPanel Margin="{TemplateBinding Margin}">
                        <!-- Section Header + Description + Actions -->
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,4">
                            <DockPanel LastChildFill="True">
                                <ContentPresenter DockPanel.Dock="Right"
                                                  Content="{TemplateBinding Actions}"
                                                  ContentTemplate="{TemplateBinding ActionsTemplate}"
                                                  VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      TextElement.FontSize="16"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="GroupDesc" Text="{TemplateBinding Description}"
                                               FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Items host for SettingRow elements -->
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="GroupDesc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMatch" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings category tab -->
    <Style TargetType="controls:SettingsCategory">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsCategory">
                    <Border x:Name="TabChrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,6,0" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              RecognizesAccessKey="True"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="Medium" />
                            <Border x:Name="BadgeBorder" Background="{DynamicResource NeutralSoft}"
                                    CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Badge, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMatch" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SearchableSettingsView shell -->
    <Style TargetType="controls:SearchableSettingsView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SearchableSettingsView">
                    <Grid Background="{TemplateBinding Background}">
                        <DockPanel LastChildFill="True">
                            <!-- Top Header: Title + Subtitle on left, Search box on right -->
                            <Border DockPanel.Dock="Top" Margin="0,0,0,16">
                                <DockPanel LastChildFill="True">
                                    <!-- Search box with Ctrl+K shortcut -->
                                    <controls:SearchBox x:Name="PART_SearchBox"
                                                        DockPanel.Dock="Right"
                                                        Width="240"
                                                        Placeholder="{TemplateBinding SearchPlaceholder}"
                                                        Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />

                                    <!-- Page Title and Description -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   FontSize="22" FontWeight="Bold"
                                                   Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock x:Name="PART_Description"
                                                   Text="{TemplateBinding Description}"
                                                   FontSize="13" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Horizontal Category Tab Strip -->
                            <Border x:Name="TabStripBorder" DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                    Margin="0,0,0,20">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>

                            <!-- Main content area -->
                            <Grid>
                                <!-- Category View -->
                                <ScrollViewer x:Name="CategoryContent"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Items, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" />
                                </ScrollViewer>

                                <!-- Empty State when search has 0 matches -->
                                <controls:EmptyState x:Name="NoMatchesState"
                                                     Visibility="Collapsed"
                                                     Title="No settings found"
                                                     Description="No settings match your search term. Try another keyword."
                                                     Icon="M 11,4 A 7,7 0 1 0 11,18 A 7,7 0 1 0 11,4 Z M 16,16 L 21,21"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasMatches" Value="False">
                            <Setter TargetName="TabStripBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CategoryContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NoMatchesState" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Avatar: circular image or fallback initials with status badge -->
    <Style TargetType="controls:Avatar">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Surface}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Avatar">
                    <Grid Width="{TemplateBinding AvatarSize}" Height="{TemplateBinding AvatarSize}" SnapsToDevicePixels="True">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="InitialsBlock" Text="{TemplateBinding Initials}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ImagePart" Source="{TemplateBinding Source}" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="StatusIndicator" Width="10" Height="10" CornerRadius="5"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-1,-1" BorderBrush="{DynamicResource Surface}" BorderThickness="1.5"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasImage" Value="True">
                            <Setter TargetName="ImagePart" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InitialsBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="Online">
                            <Setter TargetName="StatusIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StatusIndicator" Property="Background" Value="{DynamicResource Positive}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Busy">
                            <Setter TargetName="StatusIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StatusIndicator" Property="Background" Value="{DynamicResource Negative}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Away">
                            <Setter TargetName="StatusIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StatusIndicator" Property="Background" Value="{DynamicResource Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Offline">
                            <Setter TargetName="StatusIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StatusIndicator" Property="Background" Value="{DynamicResource TextSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AvatarGroup: overlapping group of avatars with +N overflow -->
    <Style TargetType="controls:AvatarGroup">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:AvatarGroup">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsPresenter />
                        <Border x:Name="OverflowPill" Width="{TemplateBinding AvatarSize}" Height="{TemplateBinding AvatarSize}"
                                CornerRadius="999" Background="{DynamicResource NeutralSoft}"
                                BorderBrush="{DynamicResource Surface}" BorderThickness="2"
                                Margin="-8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{Binding OverflowCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='+{0}'}"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflow" Value="True">
                            <Setter TargetName="OverflowPill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InlineAlert: notification banner card with title, message, semantic styling, and dismiss -->
    <Style TargetType="controls:InlineAlert">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:InlineAlert">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="AlertIcon" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{DynamicResource Accent}" Margin="0,2,12,0" VerticalAlignment="Top"
                                  Data="M 8 1.5 C 4.41 1.5 1.5 4.41 1.5 8 C 1.5 11.59 4.41 14.5 8 14.5 C 11.59 14.5 14.5 11.59 14.5 8 C 14.5 4.41 11.59 1.5 8 1.5 Z M 8 11.5 C 7.59 11.5 7.25 11.16 7.25 10.75 L 7.25 7.75 C 7.25 7.34 7.59 7 8 7 C 8.41 7 8.75 7.34 8.75 7.75 L 8.75 10.75 C 8.75 11.16 8.41 11.5 8 11.5 Z M 8 5.75 C 7.45 5.75 7 5.3 7 4.75 C 7 4.2 7.45 3.75 8 3.75 C 8.55 3.75 9 4.2 9 4.75 C 9 5.3 8.55 5.75 8 5.75 Z" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleBlock" Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" />
                                <ContentPresenter x:Name="MessagePresenter" Content="{TemplateBinding Message}"
                                                  Margin="0,2,0,0" TextElement.FontSize="12.5" TextElement.Foreground="{DynamicResource TextMuted}" />
                                <Button x:Name="PART_ActionButton" Content="{TemplateBinding ActionText}"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Padding="0" Height="Auto" FontWeight="SemiBold"
                                        Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                            </StackPanel>

                            <Button x:Name="PART_CloseButton" Grid.Column="2" Style="{x:Null}" Focusable="False"
                                    Margin="8,0,0,0" VerticalAlignment="Top" Cursor="Hand" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="4" Width="18" Height="18">
                                            <Path Data="M 4 4 L 12 12 M 12 4 L 4 12" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.65" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDismissible" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasActionText" Value="True">
                            <Setter TargetName="PART_ActionButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Info">
                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="AlertIcon" Property="Fill" Value="{DynamicResource Accent}" />
                            <Setter TargetName="AlertIcon" Property="Data" Value="M 8 1.5 C 4.41 1.5 1.5 4.41 1.5 8 C 1.5 11.59 4.41 14.5 8 14.5 C 11.59 14.5 14.5 11.59 14.5 8 C 14.5 4.41 11.59 1.5 8 1.5 Z M 8 11.5 C 7.59 11.5 7.25 11.16 7.25 10.75 L 7.25 7.75 C 7.25 7.34 7.59 7 8 7 C 8.41 7 8.75 7.34 8.75 7.75 L 8.75 10.75 C 8.75 11.16 8.41 11.5 8 11.5 Z M 8 5.75 C 7.45 5.75 7 5.3 7 4.75 C 7 4.2 7.45 3.75 8 3.75 C 8.55 3.75 9 4.2 9 4.75 C 9 5.3 8.55 5.75 8 5.75 Z" />
                        </Trigger>
                        <Trigger Property="State" Value="Positive">
                            <Setter Property="Background" Value="{DynamicResource PositiveSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Positive}" />
                            <Setter TargetName="AlertIcon" Property="Fill" Value="{DynamicResource Positive}" />
                            <Setter TargetName="AlertIcon" Property="Data" Value="M 8 1.5 C 4.41 1.5 1.5 4.41 1.5 8 C 1.5 11.59 4.41 14.5 8 14.5 C 11.59 14.5 14.5 11.59 14.5 8 C 14.5 4.41 11.59 1.5 8 1.5 Z M 6.5 10.8 L 3.8 8.1 L 4.9 7 L 6.5 8.6 L 11.1 4 L 12.2 5.1 Z" />
                        </Trigger>
                        <Trigger Property="State" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
                            <Setter TargetName="AlertIcon" Property="Fill" Value="{DynamicResource Warning}" />
                            <Setter TargetName="AlertIcon" Property="Data" Value="M 8 1.5 L 15 14 L 1 14 Z M 8 5.5 C 7.5 5.5 7.2 5.8 7.2 6.2 L 7.4 10 C 7.4 10.4 7.7 10.7 8 10.7 C 8.3 10.7 8.6 10.4 8.6 10 L 8.8 6.2 C 8.8 5.8 8.5 5.5 8 5.5 Z M 8 11.7 C 7.5 11.7 7.2 12 7.2 12.4 C 7.2 12.8 7.5 13.1 8 13.1 C 8.5 13.1 8.8 12.8 8.8 12.4 C 8.8 12 8.5 11.7 8 11.7 Z" />
                        </Trigger>
                        <Trigger Property="State" Value="Negative">
                            <Setter Property="Background" Value="{DynamicResource NegativeSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Negative}" />
                            <Setter TargetName="AlertIcon" Property="Fill" Value="{DynamicResource Negative}" />
                            <Setter TargetName="AlertIcon" Property="Data" Value="M 8 1.5 C 4.41 1.5 1.5 4.41 1.5 8 C 1.5 11.59 4.41 14.5 8 14.5 C 11.59 14.5 14.5 11.59 14.5 8 C 14.5 4.41 11.59 1.5 8 1.5 Z M 8 4.5 C 8.41 4.5 8.75 4.84 8.75 5.25 L 8.75 8.25 C 8.75 8.66 8.41 9 8 9 C 7.59 9 7.25 8.66 7.25 8.25 L 7.25 5.25 C 7.25 4.84 7.59 4.5 8 4.5 Z M 8 10.25 C 8.55 10.25 9 10.7 9 11.25 C 9 11.8 8.55 12.25 8 12.25 C 7.45 12.25 7 11.8 7 11.25 C 7 10.7 7.45 10.25 8 10.25 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BreadcrumbBar: navigation hierarchy trail -->
    <Style TargetType="controls:BreadcrumbBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:BreadcrumbBar">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:BreadcrumbItem">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="IconPath" Data="{TemplateBinding Icon}" Fill="{TemplateBinding Foreground}"
                              Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                              Visibility="Collapsed" />
                        <ContentPresenter x:Name="HeaderPresenter" Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Path x:Name="Separator" Data="M 0 0 L 3.5 4 L 0 8" Stroke="{DynamicResource TextSubtle}"
                              StrokeThickness="1.2" Margin="8,0,8,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCurrent" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="HasIcon" Value="True">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PaginationBar: table/data pagination bar with Previous/Next, page tokens, and record counts -->
    <Style TargetType="controls:PaginationBar">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PaginationBar">
                    <Grid SnapsToDevicePixels="True" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{TemplateBinding SummaryText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" FontSize="12.5" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="‹ Previous" Command="controls:PaginationBar.PreviousPageCommand"
                                    Style="{StaticResource {x:Type Button}}" Height="28" Padding="10,0" Margin="0,0,6,0" />

                            <ItemsControl ItemsSource="{TemplateBinding PageItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type controls:PageToken}">
                                        <Grid Margin="2,0">
                                            <Button x:Name="PageBtn" Content="{Binding Text}" Command="controls:PaginationBar.GoToPageCommand"
                                                    CommandParameter="{Binding PageNumber}" Width="30" Height="28" Padding="0"
                                                    Style="{StaticResource {x:Type Button}}" />
                                            <TextBlock x:Name="EllipsisText" Text="…" Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" Visibility="Collapsed" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                <Setter TargetName="PageBtn" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="EllipsisText" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="PageBtn" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                <Setter TargetName="PageBtn" Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="PageBtn" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="PageBtn" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Next ›" Command="controls:PaginationBar.NextPageCommand"
                                    Style="{StaticResource {x:Type Button}}" Height="28" Padding="10,0" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CustomWindow TitleBar Button Styles -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#C4101E" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CustomWindow: modern chromeless window with customizable title bar slots & native snap/drag gestures -->
    <Style TargetType="controls:CustomWindow">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CustomWindow">
                    <Border x:Name="WindowFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="WindowRoot">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Title Bar -->
                            <Grid x:Name="PART_TitleBar" Height="{TemplateBinding TitleBarHeight}"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: App Icon & Window Title -->
                                <StackPanel x:Name="PART_TitleArea" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                                    <Image x:Name="WindowIcon" Source="{TemplateBinding Icon}" Width="16" Height="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock x:Name="WindowTitle" Text="{TemplateBinding Title}" FontWeight="Medium" FontSize="12.5"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Left Content slot (e.g. Navigation icons, tabs, back/forward) -->
                                <ContentPresenter x:Name="PART_TitleBarLeftContent" Grid.Column="1"
                                                  Content="{TemplateBinding TitleBarLeftContent}"
                                                  ContentTemplate="{TemplateBinding TitleBarLeftContentTemplate}"
                                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                                  VerticalAlignment="Center" />

                                <!-- Center Content slot (e.g. Search Box, SegmentedControl, Command Palette) -->
                                <ContentPresenter x:Name="PART_TitleBarContent" Grid.Column="2"
                                                  Content="{TemplateBinding TitleBarContent}"
                                                  ContentTemplate="{TemplateBinding TitleBarContentTemplate}"
                                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />

                                <!-- Right Content slot (e.g. Theme Toggle, User Profile, Action buttons) -->
                                <ContentPresenter x:Name="PART_TitleBarRightContent" Grid.Column="3"
                                                  Content="{TemplateBinding TitleBarRightContent}"
                                                  ContentTemplate="{TemplateBinding TitleBarRightContentTemplate}"
                                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0" />

                                <!-- Window Control Buttons -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="PART_MinimizeButton" Style="{StaticResource TitleBarButton}"
                                            Height="{TemplateBinding TitleBarHeight}" ToolTip="Minimize">
                                        <Path Data="M 0 5 L 10 5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.2" />
                                    </Button>

                                    <Button x:Name="PART_MaximizeButton" Style="{StaticResource TitleBarButton}"
                                            Height="{TemplateBinding TitleBarHeight}" ToolTip="Maximize">
                                        <Grid>
                                            <Path x:Name="MaximizeGlyph" Data="M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.2" />
                                            <Path x:Name="RestoreGlyph" Data="M 2.5 0.5 H 9.5 V 7.5 H 7.5 M 7.5 2.5 H 0.5 V 9.5 H 7.5 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.2" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="PART_CloseButton" Style="{StaticResource TitleBarCloseButton}"
                                            Height="{TemplateBinding TitleBarHeight}" ToolTip="Close">
                                        <Path Data="M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.2" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Client Content Area -->
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasIcon" Value="True">
                            <Setter TargetName="WindowIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsTitleVisible" Value="False">
                            <Setter TargetName="WindowTitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsTitleVisible" Value="False" />
                                <Condition Property="HasIcon" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TitleArea" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsTitleBarVisible" Value="False">
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMaximizeButton" Value="False">
