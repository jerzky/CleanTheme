<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CleanTheme.Wpf.Controls">

    <!-- Default styles of the CleanTheme controls. The palette is merged here so the controls look right
         even in an application that has not merged CleanThemeResources. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CleanTheme.Wpf;component/Themes/CleanTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="controls:StatusPill">
        <Setter Property="Background" Value="{StaticResource NeutralSoft}" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusPill">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="State" Value="Info">
                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="State" Value="Positive">
                <Setter Property="Background" Value="{StaticResource PositiveSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Positive}" />
            </Trigger>
            <Trigger Property="State" Value="Warning">
                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Warning}" />
            </Trigger>
            <Trigger Property="State" Value="Negative">
                <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Negative}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="controls:Card">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Card">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <DockPanel x:Name="TitleRow" DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                                <ContentPresenter DockPanel.Dock="Left" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource Text}" />
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Actions" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TitleRow" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:MetricTile">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MetricTile">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{TemplateBinding Label}" />
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{TemplateBinding Value}" VerticalAlignment="Bottom"
                                              TextElement.FontSize="18" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource Text}"
                                              Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="UnitText" Text="{TemplateBinding Unit}" Margin="4,0,0,3" VerticalAlignment="Bottom"
                                       FontSize="12" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control: a sunken track holding the choices; the selected one is lifted onto the surface. -->
    <Style TargetType="controls:SegmentedControl">
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="2"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SegmentedItem">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedItem">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Border}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
