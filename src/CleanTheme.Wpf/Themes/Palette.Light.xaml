<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette. Palette.Dark.xaml defines the same keys; ThemeManager swaps between them at runtime, so styles
        reference these with DynamicResource. Keys are public API.
        Accent is for text, lines and tints; AccentFill (and AccentHover/AccentPressed) for solid fills under OnAccent text.
    -->

    <Color x:Key="AppBackgroundColor">#F4F6F9</Color>
    <SolidColorBrush x:Key="AppBackground" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Hover" Color="#F1F4F8" />
    <SolidColorBrush x:Key="Pressed" Color="#E7EBF1" />
    <SolidColorBrush x:Key="Border" Color="#E2E7EE" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C9D1DC" />
    <SolidColorBrush x:Key="Divider" Color="#EDF0F4" />

    <SolidColorBrush x:Key="Text" Color="#18212F" />
    <SolidColorBrush x:Key="TextMuted" Color="#5A6576" />
    <SolidColorBrush x:Key="TextSubtle" Color="#7F8A9B" />
    <SolidColorBrush x:Key="TextLog" Color="#334155" />

    <SolidColorBrush x:Key="Accent" Color="#1D4B87" />
    <SolidColorBrush x:Key="AccentFill" Color="#1D4B87" />
    <SolidColorBrush x:Key="AccentHover" Color="#173D6F" />
    <SolidColorBrush x:Key="AccentPressed" Color="#123159" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E7EEF7" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <Color x:Key="FocusRingColor">#1D4B87</Color>
    <SolidColorBrush x:Key="FocusRing" Color="#1D4B87" Opacity="0.25" />

    <SolidColorBrush x:Key="Positive" Color="#16794A" />
    <SolidColorBrush x:Key="PositiveSoft" Color="#E5F3EB" />
    <SolidColorBrush x:Key="Warning" Color="#8F6200" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FCF1D5" />
    <SolidColorBrush x:Key="Negative" Color="#B42318" />
    <SolidColorBrush x:Key="NegativeFill" Color="#B42318" />
    <SolidColorBrush x:Key="NegativeSoft" Color="#FCEBE9" />
    <SolidColorBrush x:Key="NegativeBorder" Color="#F0C5C0" />
    <SolidColorBrush x:Key="NegativeHover" Color="#9A1D14" />
    <SolidColorBrush x:Key="NegativePressed" Color="#82170F" />
    <SolidColorBrush x:Key="NeutralSoft" Color="#EDF0F4" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="#18212F" />
    <SolidColorBrush x:Key="ToolTipText" Color="#FFFFFF" />

</ResourceDictionary>
