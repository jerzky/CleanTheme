<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:logging="clr-namespace:CleanTheme.Logging"
                    xmlns:controls="clr-namespace:CleanTheme.Wpf.Controls;assembly=CleanTheme.Wpf"
                    xmlns:mel="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CleanTheme.Wpf;component/Themes/CleanTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="LogBooleanToVisibility" />

    <!-- One line: time, level tag, origin (source or short category), message. Warnings and errors color the tag and the message. -->
    <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type logging:LogEntry}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TimestampUtc, StringFormat=HH:mm:ss.fff}" Foreground="{StaticResource TextSubtle}" Margin="0,0,12,0" />
            <TextBlock x:Name="Tag" Grid.Column="1" Text="{Binding LevelTag}" Foreground="{StaticResource TextSubtle}" Margin="0,0,12,0" />
            <TextBlock Grid.Column="2" Text="{Binding Origin}" ToolTip="{Binding Category}" Width="110" Margin="0,0,12,0"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"
                       Visibility="{Binding ShowOrigin, RelativeSource={RelativeSource AncestorType=logging:LogView}, Converter={StaticResource LogBooleanToVisibility}}" />
            <TextBlock x:Name="Message" Grid.Column="3" Text="{Binding Message}" TextWrapping="NoWrap" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Information">
                <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning">
                <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Warning}" />
                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Negative}" />
                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Critical">
                <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Negative}" />
                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Negative}" />
                <Setter TargetName="Message" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Debug">
                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource TextSubtle}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Trace">
                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource TextSubtle}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Compact funnel button in the filter bar. Tag="Active" (set by LogView while a filter is on) tints it. -->
    <Style x:Key="LogFilterButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,0 L 10,0 L 6.2,4.6 L 6.2,9 L 3.8,7.8 L 3.8,4.6 Z" Fill="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="Filter" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pressed}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One selectable line: no chrome, a soft hover, the accent tint when selected. -->
    <Style x:Key="LogLineContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="4,0" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- x:Shared="False": each LogView gets its own menu (a ContextMenu has one parent). -->
    <ContextMenu x:Key="LogContextMenu" x:Shared="False" Style="{StaticResource CleanContextMenu}">
        <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="Copy all lines" Command="logging:LogView.CopyAllCommand"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </ContextMenu>

    <Style TargetType="logging:LogView">
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
        <Setter Property="Foreground" Value="{StaticResource TextLog}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LogLineContainer}" />
        <Setter Property="ContextMenu" Value="{StaticResource LogContextMenu}" />
        <Setter Property="ItemTemplate" Value="{StaticResource LogEntryTemplate}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Controls inside get their CleanTheme styles explicitly, so the view looks right
                     even in an application that has not merged the theme. -->
                <ControlTemplate TargetType="logging:LogView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <DockPanel>
                            <!-- Filter bar: line count on the left, filter popout on the right. -->
                            <Border x:Name="FilterBar" DockPanel.Dock="Top" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                                    Padding="10,3,4,3" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="11.5">
                                <DockPanel>
                                    <ToggleButton x:Name="PART_FilterButton" DockPanel.Dock="Right" Style="{StaticResource LogFilterButton}"
                                                  IsChecked="{Binding IsOpen, ElementName=PART_FilterPopup, Mode=TwoWay}"
                                                  ToolTip="Filter lines" AutomationProperties.Name="Filter" />
                                    <!-- "340 lines", or "120 of 340 lines" while filtered. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                TextElement.Foreground="{StaticResource TextSubtle}">
                                        <TextBlock Text="{Binding Feed.Visible.Count, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <TextBlock x:Name="OfTotal" Visibility="Collapsed"
                                                   Text="{Binding Feed.TotalCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}&#160;of {0}}" />
                                        <TextBlock Text="&#160;lines" />
                                    </StackPanel>

                                    <Popup x:Name="PART_FilterPopup" PlacementTarget="{Binding ElementName=PART_FilterButton}"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                                CornerRadius="6" Padding="14,6,14,12" Width="300" Margin="0,0,8,8"
                                                TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13"
                                                TextElement.Foreground="{StaticResource Text}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Level" />
                                                <controls:SegmentedControl x:Name="LevelChoices" SelectedValuePath="Tag"
                                                                           SelectedValue="{Binding Feed.MinimumLevel, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <controls:SegmentedItem Content="All" Tag="{x:Static mel:LogLevel.Trace}" />
                                                    <controls:SegmentedItem Content="Info+" Tag="{x:Static mel:LogLevel.Information}" />
                                                    <controls:SegmentedItem Content="Warnings+" Tag="{x:Static mel:LogLevel.Warning}" />
                                                    <controls:SegmentedItem Content="Errors" Tag="{x:Static mel:LogLevel.Error}" />
                                                </controls:SegmentedControl>

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Source" />
                                                <ComboBox x:Name="PART_SourceBox" Style="{StaticResource {x:Type ComboBox}}"
                                                          ItemContainerStyle="{StaticResource {x:Type ComboBoxItem}}" />

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Category" />
                                                <ComboBox x:Name="PART_CategoryBox" Style="{StaticResource {x:Type ComboBox}}"
                                                          ItemContainerStyle="{StaticResource {x:Type ComboBoxItem}}" />

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Message contains" />
                                                <TextBox Style="{StaticResource {x:Type TextBox}}"
                                                         Text="{Binding Feed.TextFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

                                                <Button x:Name="PART_ResetButton" Content="Reset filters" Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Right" Margin="0,10,-8,0" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </DockPanel>
                            </Border>

                            <ScrollViewer x:Name="PART_ScrollViewer" Style="{StaticResource {x:Type ScrollViewer}}"
                                          Padding="{TemplateBinding Padding}" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowFilterBar" Value="False">
                            <Setter TargetName="FilterBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Without this, clicking the button while the popout is open closes it (StaysOpen) and reopens it. -->
                        <Trigger SourceName="PART_FilterPopup" Property="IsOpen" Value="True">
                            <Setter TargetName="PART_FilterButton" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Feed.IsFiltered, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_FilterButton" Property="Tag" Value="Active" />
                            <Setter TargetName="OfTotal" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
