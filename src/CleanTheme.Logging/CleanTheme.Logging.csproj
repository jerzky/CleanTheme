<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>In-app log for WPF: an ILoggerProvider feeding a bounded, filterable LogFeed, and a CleanTheme LogView to show it.</Description>
    <PackageTags>$(PackageTags);logging;log viewer</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <ProjectReference Include="..\CleanTheme.Wpf\CleanTheme.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CleanTheme.Logging.Tests" />
  </ItemGroup>
</Project>
