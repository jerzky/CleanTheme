<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every style of the theme on one page, for eyeballing changes. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CleanTheme.Wpf\CleanTheme.Wpf.csproj" />
  </ItemGroup>

  <!-- Program.Main is the entry point, so App.xaml must not generate one. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
