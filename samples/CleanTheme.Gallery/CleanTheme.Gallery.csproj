<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every style and control of both packages on one page, for eyeballing changes. Built like a real app:
       Generic Host, hosted services logging through ILogger into the LogView. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One target, so `dotnet run` needs no -f. -->
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CleanTheme.Wpf\CleanTheme.Wpf.csproj" />
    <ProjectReference Include="..\..\src\CleanTheme.Logging\CleanTheme.Logging.csproj" />
  </ItemGroup>

  <!-- Program.Main is the entry point, so App.xaml must not generate one. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
