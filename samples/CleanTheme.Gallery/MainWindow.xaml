<Window x:Class="CleanTheme.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:clean="https://github.com/jerzky/CleanTheme"
        Title="CleanTheme Gallery"
        Height="860" Width="1180"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CleanWindow}">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CleanTheme" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Gallery" FontSize="18" Foreground="{StaticResource TextSubtle}" Margin="6,0,16,0" VerticalAlignment="Center" />
                <clean:StatusPill State="Positive" Content="Running" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Buttons -->
                <clean:Card Header="Buttons">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Primary" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                            <Button Content="Secondary" Margin="0,0,8,8" />
                            <Button Content="Danger" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
                            <Button Content="Ghost" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="Disabled" IsEnabled="False" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SegmentedControl" />
                        <clean:SegmentedControl SelectedIndex="0">
                            <clean:SegmentedItem Content="1×" />
                            <clean:SegmentedItem Content="2×" />
                            <clean:SegmentedItem Content="4×" />
                            <clean:SegmentedItem Content="8×" />
                        </clean:SegmentedControl>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SegmentButton (RadioButtons)" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scale" Content="1×" IsChecked="True" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scale" Content="2×" Margin="4,0,0,0" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scale" Content="4×" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </clean:Card>

                <!-- Inputs -->
                <clean:Card Grid.Column="2" Header="Inputs">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" Margin="0,0,0,4" />
                        <TextBox Text="ALPHA-1" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Speed (kts)" />
                        <TextBox Style="{StaticResource NumericTextBox}" Text="420" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Profile" />
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Fast" />
                            <ComboBoxItem Content="Quiet" />
                        </ComboBox>
                    </StackPanel>
                </clean:Card>

                <!-- Metrics and status -->
                <clean:Card Grid.Row="2" Header="Metrics and status">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <clean:MetricTile Label="Units" Value="42" />
                            <clean:MetricTile Label="Tick" Value="12.4" Unit="ms" />
                            <clean:MetricTile Label="Uptime" Value="01:12:09" />
                        </UniformGrid>
                        <WrapPanel Margin="0,16,0,0">
                            <clean:StatusPill Content="Neutral" Margin="0,0,6,0" />
                            <clean:StatusPill State="Info" Content="Info" Margin="0,0,6,0" />
                            <clean:StatusPill State="Positive" Content="OK" Margin="0,0,6,0" />
                            <clean:StatusPill State="Warning" Content="Warning" Margin="0,0,6,0" />
                            <clean:StatusPill State="Negative" Content="Error" />
                        </WrapPanel>
                    </StackPanel>
                </clean:Card>

                <!-- Scrolling -->
                <clean:Card Grid.Row="2" Grid.Column="2" Header="Scrolling">
                    <ListBox x:Name="LongList" Height="130" BorderBrush="{StaticResource Border}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </clean:Card>

                <!-- Log -->
                <clean:Card Grid.Row="4" Grid.ColumnSpan="3" Header="LogView">
                    <clean:Card.Actions>
                        <StackPanel Orientation="Horizontal">
                            <clean:SegmentedControl x:Name="LevelFilter" SelectedIndex="0" Margin="0,0,8,0"
                                                    SelectionChanged="OnLevelFilterChanged">
                                <clean:SegmentedItem Content="All" />
                                <clean:SegmentedItem Content="Info+" />
                                <clean:SegmentedItem Content="Warnings+" />
                            </clean:SegmentedControl>
                            <Button Content="Log an error" Style="{StaticResource GhostButton}" Click="OnLogError" />
                            <Button Content="Clear" Style="{StaticResource GhostButton}" Click="OnClearLog" />
                        </StackPanel>
                    </clean:Card.Actions>
                    <clean:LogView x:Name="Log" Height="180" />
                </clean:Card>

                <!-- Table -->
                <clean:Card Grid.Row="6" Grid.ColumnSpan="3" Header="Table" Padding="0,16,0,0">
                    <DataGrid x:Name="Rows">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" />
                            <DataGridTemplateColumn Header="STATE" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <clean:StatusPill State="{Binding State}" Content="{Binding State}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="COUNT" Binding="{Binding Count}" Width="90"
                                                HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="VALUE" Binding="{Binding Value, StringFormat=N2}" Width="110"
                                                HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}" Content="Open" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </clean:Card>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
