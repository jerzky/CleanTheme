<clean:CustomWindow x:Class="CleanTheme.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:clean="https://github.com/jerzky/CleanTheme"
        Title="CleanTheme Gallery"
        Height="900" Width="1200"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type clean:CustomWindow}}">

    <!-- Interactive title bar controls -->
    <clean:CustomWindow.TitleBarContent>
        <Border MaxWidth="380" Height="26" Background="{DynamicResource SurfaceSunken}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5"
                Padding="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="M 9.5,3 A 6.5,6.5 0 0 1 16,9.5 C 16,11.1 15.41,12.58 14.44,13.73 L 18.71,18 L 18,18.71 L 13.73,14.44 C 12.58,15.41 11.1,16 9.5,16 A 6.5,6.5 0 1 1 9.5,3 M 9.5,4 A 5.5,5.5 0 1 0 9.5,15 A 5.5,5.5 0 0 0 9.5,4 Z"
                      Fill="{DynamicResource TextSubtle}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="12"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                         Text="Search components, tokens, logs..." />
                <Border Grid.Column="2" Background="{DynamicResource NeutralSoft}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+K" FontSize="9.5" Foreground="{DynamicResource TextSubtle}" FontFamily="Consolas, Segoe UI" />
                </Border>
            </Grid>
        </Border>
    </clean:CustomWindow.TitleBarContent>

    <clean:CustomWindow.TitleBarRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
            <Button Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                    ToolTip="CleanTheme repository on GitHub" Click="OnOpenGitHub">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33c.85 0 1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
                          Fill="{DynamicResource TextMuted}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="GitHub" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </clean:CustomWindow.TitleBarRightContent>

    <Grid>
        <!-- The HamburgerMenu acts as the primary shell and navigation drawer -->
        <clean:HamburgerMenu x:Name="NavRail" SelectedIndex="0" IsPaneOpen="True">
            <!-- Large prominent logo when open -->
            <clean:HamburgerMenu.Header>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Accent}">
                        <Path Data="M 6,10 L 17,2 L 28,10 L 28,24 L 6,24 Z" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CleanTheme" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Text}" />
                        <TextBlock Text="Gallery Showcase" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                    </StackPanel>
                </StackPanel>
            </clean:HamburgerMenu.Header>

            <!-- Compact logo glyph when collapsed -->
            <clean:HamburgerMenu.CompactHeader>
                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Accent}">
                    <Path Data="M 6,10 L 17,2 L 28,10 L 28,24 L 6,24 Z" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.8"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14" Stretch="Uniform" />
                </Border>
            </clean:HamburgerMenu.CompactHeader>

            <!-- Primary Navigation Items -->
            <clean:HamburgerMenuItem Icon="M 3,12 L 12,3 L 21,12 V 20 H 3 Z" Text="Overview &amp; Controls" />
            <clean:HamburgerMenuItem Icon="M 4,4 H 10 V 10 H 4 Z M 14,4 H 20 V 10 H 14 Z M 4,14 H 10 V 20 H 4 Z M 14,14 H 20 V 20 H 14 Z" Text="Workspaces" Badge="3" />
            <clean:HamburgerMenuItem Icon="M 4,6 H 20 M 4,12 H 20 M 4,18 H 14" Text="Activity Logs" />
            <clean:HamburgerMenuItem Icon="M 2,4 H 22 V 16 H 6 L 2,20 Z" Text="Feedback &amp; Dialogs" />
            <clean:HamburgerMenuItem Icon="M 19.14,12.94 C 19.18,12.63 19.2,12.32 19.2,12 C 19.2,11.68 19.18,11.37 19.14,11.06 L 21.16,9.48 C 21.34,9.34 21.39,9.08 21.28,8.88 L 19.36,5.56 C 19.24,5.36 19,5.28 18.79,5.36 L 16.42,6.32 C 15.93,5.94 15.39,5.63 14.81,5.39 L 14.45,2.87 C 14.41,2.64 14.21,2.47 13.98,2.47 L 10.02,2.47 C 9.79,2.47 9.59,2.64 9.55,2.87 L 9.19,5.39 C 8.61,5.63 8.07,5.94 7.58,6.32 L 5.21,5.36 C 5,5.28 4.76,5.36 4.64,5.56 L 2.72,8.88 C 2.61,9.08 2.66,9.34 2.84,9.48 L 4.86,11.06 C 4.82,11.37 4.8,11.68 4.8,12 C 4.8,12.32 4.82,12.63 4.86,12.94 L 2.84,14.52 C 2.66,14.66 2.61,14.92 2.72,15.12 L 4.64,18.44 C 4.76,18.64 5,18.72 5.21,18.64 L 7.58,17.68 C 8.07,18.06 8.61,18.37 9.19,18.61 L 9.55,21.13 C 9.59,21.36 9.79,21.53 10.02,21.53 L 13.98,21.53 C 14.21,21.53 14.41,21.36 14.45,21.13 L 14.81,18.61 C 15.39,18.37 15.93,18.06 16.42,17.68 L 18.79,18.64 C 19,18.72 19.24,18.64 19.36,18.44 L 21.28,15.12 C 21.39,14.92 21.34,14.66 21.16,14.52 L 19.14,12.94 Z M 12,15.5 C 10.07,15.5 8.5,13.93 8.5,12 C 8.5,10.07 10.07,8.5 12,8.5 C 13.93,8.5 15.5,10.07 15.5,12 C 15.5,13.93 13.93,15.5 12,15.5 Z" Text="Settings" />

            <!-- Bottom User Profile Button with Drop-up Menu -->
            <clean:HamburgerMenu.Footer>
                <clean:HamburgerProfileButton DisplayName="jens" Subtitle="Pro" Avatar="J"
                                              TrailingIcon="M 12,2 L 12,6 M 9,9 A 5,5 0 0 1 15,9 M 5,13 L 2,13 M 22,13 L 19,13 M 6,19 L 3,22 M 18,19 L 21,22"
                                              TrailingToolTip="Report an issue">
                    <clean:HamburgerProfileButton.ContextMenu>
                        <ContextMenu Placement="Top">
                            <MenuItem Header="Settings" InputGestureText="Ctrl+," Click="OnOpenSettings" />
                            <MenuItem Header="Usage" />
                            <MenuItem Header="Language" />
                            <MenuItem Header="Get help" />
                            <Separator />
                            <MenuItem Header="Upgrade plan" />
                            <MenuItem Header="Get apps and extensions" />
                            <MenuItem Header="View changelog" />
                            <MenuItem Header="Learn more" />
                            <Separator />
                            <MenuItem Header="Get API keys" />
                            <MenuItem Header="Log out" Click="OnExit" />
                        </ContextMenu>
                    </clean:HamburgerProfileButton.ContextMenu>
                </clean:HamburgerProfileButton>
            </clean:HamburgerMenu.Footer>

            <!-- Main Content Area -->
            <clean:HamburgerMenu.Content>
                <DockPanel>
                    <!-- Header bar: current section title, status, theme picker, menu bar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1" Padding="20,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.Text, ElementName=NavRail}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <clean:StatusPill State="Positive" Content="Running" ToolTip="Hosted services are logging" Margin="14,0,0,0" />
                            </StackPanel>

                            <clean:SegmentedControl x:Name="ThemeChoice" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                                    SelectionChanged="OnThemeChoiceChanged" ToolTip="Theme">
                                <clean:SegmentedItem Content="Light" />
                                <clean:SegmentedItem Content="Dark" />
                                <clean:SegmentedItem Content="System" />
                            </clean:SegmentedControl>

                            <Menu HorizontalAlignment="Right" VerticalAlignment="Center">
                                <MenuItem Header="_File">
                                    <MenuItem Header="_New workspace" InputGestureText="Ctrl+N" Click="OnNewScenario" />
                                    <MenuItem Header="Open _recent">
                                        <MenuItem Header="workspace-prod.json" />
                                        <MenuItem Header="staging-environment.json" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
                                </MenuItem>
                                <MenuItem Header="_View">
                                    <MenuItem Header="Show line _origin" IsCheckable="True"
                                              IsChecked="{Binding ShowOrigin, ElementName=Log, Mode=TwoWay}" />
                                    <MenuItem Header="Follow new _lines" IsCheckable="True"
                                              IsChecked="{Binding AutoScroll, ElementName=Log, Mode=TwoWay}" />
                                </MenuItem>
                                <MenuItem Header="_Help">
                                    <MenuItem Header="_About" Click="OnAbout" />
                                </MenuItem>
                            </Menu>
                        </DockPanel>
                    </Border>

                    <!-- Native page switcher bound to navigation rail selection -->
                    <TabControl x:Name="PageHost" SelectedIndex="{Binding SelectedIndex, ElementName=NavRail}"
                                BorderThickness="0" Background="Transparent" Padding="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- Page 0: Overview & Controls -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Buttons -->
                                    <clean:Card Header="Buttons">
                                        <StackPanel>
                                            <WrapPanel>
                                                <Button Content="Primary" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="PrimaryButton" />
                                                <Button Content="Secondary" Margin="0,0,8,8" ToolTip="The implicit Button style" />
                                                <Button Content="Danger" Style="{StaticResource DangerButton}" Margin="0,0,8,8" ToolTip="DangerButton" />
                                                <Button Content="Delete" Style="{StaticResource DangerPrimaryButton}" Margin="0,0,8,8" ToolTip="DangerPrimaryButton" />
                                                <Button Content="Ghost" Style="{StaticResource GhostButton}" Margin="0,0,8,8" ToolTip="GhostButton" />
                                                <Button Content="Disabled" IsEnabled="False" Margin="0,0,8,8" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="SegmentedControl" />
                                            <clean:SegmentedControl SelectedIndex="0">
                                                <clean:SegmentedItem Content="1×" />
                                                <clean:SegmentedItem Content="2×" />
                                                <clean:SegmentedItem Content="4×" />
                                                <clean:SegmentedItem Content="8×" />
                                            </clean:SegmentedControl>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="SegmentButton (RadioButtons)" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scale" Content="1×" IsChecked="True" />
                                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scale" Content="2×" Margin="4,0,0,0" />
                                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scale" Content="4×" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </clean:Card>

                                    <!-- Inputs -->
                                    <clean:Card Grid.Column="2" Header="Inputs">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" Margin="0,0,0,4" />
                                                <TextBox Text="ALPHA-1" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Profile" />
                                                <ComboBox SelectedIndex="0">
                                                    <ComboBoxItem Content="Default" />
                                                    <ComboBoxItem Content="Fast" />
                                                    <ComboBoxItem Content="Quiet" />
                                                </ComboBox>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="SearchBox" />
                                                <clean:SearchBox Placeholder="Search units" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Speed (kts), NumericUpDown" Margin="0,0,0,4" />
                                                <clean:NumericUpDown Value="420" Minimum="0" Maximum="900" Increment="10" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Altitude (ft ×1000), 1 decimal" />
                                                <clean:NumericUpDown Value="25.5" Minimum="0" Maximum="60" Increment="0.5" DecimalPlaces="1" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Start date" />
                                                <DatePicker x:Name="StartDate" />
                                            </StackPanel>
                                        </Grid>
                                    </clean:Card>

                                    <!-- Selection -->
                                    <clean:Card Grid.Row="2" Header="Selection and progress">
                                        <StackPanel>
                                            <WrapPanel>
                                                <CheckBox Content="Checked" IsChecked="True" Margin="0,0,16,8" />
                                                <CheckBox Content="Unchecked" Margin="0,0,16,8" />
                                                <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,16,8" />
                                                <CheckBox Content="Disabled" IsEnabled="False" Margin="0,0,16,8" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,4,0,0">
                                                <RadioButton Content="Primary" GroupName="Option" IsChecked="True" Margin="0,0,16,8" />
                                                <RadioButton Content="Secondary" GroupName="Option" Margin="0,0,16,8" />
                                                <RadioButton Content="Custom" GroupName="Option" Margin="0,0,16,8" />
                                                <RadioButton Content="Disabled" GroupName="Option" IsEnabled="False" Margin="0,0,16,8" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="ToggleSwitch" />
                                            <WrapPanel>
                                                <clean:ToggleSwitch Content="Active" IsChecked="True" Margin="0,0,16,8" />
                                                <clean:ToggleSwitch Content="Standby" IsChecked="False" Margin="0,0,16,8" />
                                                <clean:ToggleSwitch Content="Locked" IsEnabled="False" IsChecked="True" Margin="0,0,16,8" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Progress (determinate and indeterminate)" />
                                            <ProgressBar Value="65" Height="6" Margin="0,0,0,8" />
                                            <ProgressBar IsIndeterminate="True" Height="6" />
                                        </StackPanel>
                                    </clean:Card>

                                    <!-- Navigation & Details -->
                                    <clean:Card Grid.Row="2" Grid.Column="2" Header="Conversations and Tabs">
                                        <TabControl>
                                            <TabItem Header="Chats">
                                                <clean:NavTree Margin="0,8,0,0">
                                                    <clean:NavTreeGroup Header="Recent Conversations" IsExpanded="True">
                                                        <clean:NavTreeItem Header="Chat 1: Architecture Review" IsActive="True" IsExpanded="True">
                                                            <clean:NavTreeItem Header="Sub Chat spawned from 1" />
                                                            <clean:NavTreeItem Header="Performance Benchmarks" />
                                                        </clean:NavTreeItem>
                                                        <clean:NavTreeItem Header="Another Chat: Release v0.6.0" />
                                                        <clean:NavTreeItem Header="Design System Sync" />
                                                    </clean:NavTreeGroup>
                                                </clean:NavTree>
                                            </TabItem>
                                            <TabItem Header="Details">
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="A TabControl hosts arbitrary pages with clean, subtle indicator styling." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                                                    <Expander Header="Advanced network settings" Margin="0,12,0,0">
                                                        <StackPanel Margin="0,8,0,0">
                                                            <CheckBox Content="Enable jumbo frames (9000 MTU)" Margin="0,0,0,6" />
                                                            <CheckBox Content="Hardware timestamping" IsChecked="True" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="List">
                                                <ListBox x:Name="LongList" SelectionMode="Extended" Height="140" />
                                            </TabItem>
                                        </TabControl>
                                    </clean:Card>

                                    <!-- Badges, Avatars & Groups -->
                                    <clean:Card Grid.Row="4" Header="Badges and Avatars">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Status Badges with indicator dots &amp; dismiss" Margin="0,0,0,6" />
                                            <WrapPanel>
                                                <clean:StatusPill Content="Active" State="Positive" ShowDot="True" Margin="0,0,8,8" />
                                                <clean:StatusPill Content="Warning" State="Warning" ShowDot="True" Margin="0,0,8,8" />
                                                <clean:StatusPill Content="Error" State="Negative" ShowDot="True" Margin="0,0,8,8" />
                                                <clean:StatusPill Content="Dismissible" State="Info" ShowDot="True" IsClosable="True" Margin="0,0,8,8" />
                                                <clean:StatusPill Content="Neutral" State="Neutral" Margin="0,0,8,8" />
                                            </WrapPanel>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Avatars with presence status" Margin="0,6,0,6" />
                                            <WrapPanel VerticalAlignment="Center">
                                                <clean:Avatar Initials="JG" AvatarSize="36" Status="Online" Margin="0,0,12,8" ToolTip="Jens (Online)" />
                                                <clean:Avatar Initials="AL" AvatarSize="36" Status="Busy" Margin="0,0,12,8" ToolTip="Alice (Busy)" />
                                                <clean:Avatar Initials="MK" AvatarSize="36" Status="Away" Margin="0,0,12,8" ToolTip="Mark (Away)" />
                                                <clean:Avatar Initials="ST" AvatarSize="36" Status="Offline" Margin="0,0,12,8" ToolTip="System (Offline)" />
                                            </WrapPanel>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="AvatarGroup with +N overflow cutout" Margin="0,6,0,6" />
                                            <clean:AvatarGroup MaxDisplay="3" AvatarSize="34">
                                                <clean:Avatar Initials="U1" />
                                                <clean:Avatar Initials="U2" />
                                                <clean:Avatar Initials="U3" />
                                                <clean:Avatar Initials="U4" />
                                                <clean:Avatar Initials="U5" />
                                            </clean:AvatarGroup>
                                        </StackPanel>
                                    </clean:Card>

                                    <!-- Inline Alerts & Breadcrumbs -->
                                    <clean:Card Grid.Row="4" Grid.Column="2" Header="Alerts and Breadcrumbs">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="BreadcrumbBar hierarchy navigation" Margin="0,0,0,6" />
                                            <clean:BreadcrumbBar Margin="0,0,0,12">
                                                <clean:BreadcrumbItem Header="Home" />
                                                <clean:BreadcrumbItem Header="Workspaces" />
                                                <clean:BreadcrumbItem Header="Project Settings" />
                                            </clean:BreadcrumbBar>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Inline banner alerts" Margin="0,6,0,6" />
                                            <clean:InlineAlert State="Positive" Title="Cluster update applied"
                                                               Message="All cloud worker nodes are operating on runtime v10.0."
                                                               Margin="0,0,0,8" />
                                            <clean:InlineAlert State="Warning" Title="Elevated latency warning"
                                                               Message="Average response time exceeded 120 ms over the past 5 minutes."
                                                               ActionText="Inspect trace" IsDismissible="True" Margin="0" />
                                        </StackPanel>
                                    </clean:Card>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Page 1: Workspaces -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Metric Tiles -->
                                    <UniformGrid Columns="4">
                                        <clean:Card Margin="0,0,12,0">
                                            <clean:MetricTile Label="Workspaces" Value="8" Unit="active" />
                                        </clean:Card>
                                        <clean:Card Margin="0,0,12,0">
                                            <clean:MetricTile Label="API Latency" Value="18.2" Unit="ms" />
                                        </clean:Card>
                                        <clean:Card Margin="0,0,12,0">
                                            <clean:MetricTile Label="Throughput" Value="1.4k" Unit="req/s" />
                                        </clean:Card>
                                        <clean:Card>
                                            <clean:MetricTile Label="Cloud Storage" Value="94.2" Unit="GB" />
                                        </clean:Card>
                                    </UniformGrid>

                                    <!-- Fleet Data Table -->
                                    <clean:Card Grid.Row="2" Header="Workspace Projects" Padding="0,16,0,8">
                                        <StackPanel>
                                            <DataGrid x:Name="Rows">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="PROJECT" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <clean:Avatar Initials="{Binding Name}" AvatarSize="24" Status="Online" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="STATUS" Width="130">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <clean:StatusPill State="{Binding State}" Content="{Binding State}" ShowDot="True" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="SERVICES" Binding="{Binding Count}" Width="90"
                                                                        HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}" />
                                                    <DataGridTextColumn Header="BUDGET" Binding="{Binding Value, StringFormat=C2}" Width="110"
                                                                        HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}" />
                                                    <DataGridTemplateColumn Width="90">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource RowButton}" Content="Open" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <clean:PaginationBar TotalPages="8" CurrentPage="1" PageSize="10" TotalItems="78" Margin="12,12,12,4" />
                                        </StackPanel>
                                    </clean:Card>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Page 2: Activity Logs -->
                        <TabItem>
                            <Grid Margin="20">
                                <clean:Card Header="LogView" VerticalAlignment="Stretch">
                                    <clean:Card.Actions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Log an error" Style="{StaticResource GhostButton}" Click="OnLogError" />
                                            <Button Content="Clear" Style="{StaticResource GhostButton}" Click="OnClearLog" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </clean:Card.Actions>
                                    <clean:LogView x:Name="Log" />
                                </clean:Card>
                            </Grid>
                        </TabItem>

                        <!-- Page 3: Feedback & Dialogs -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

